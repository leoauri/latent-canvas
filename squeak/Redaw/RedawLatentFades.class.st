	aFrame data size ~= silence size ifTrue: [^ aFrame].
	onsets := self class constant: 'ON'.
	n := 1 max: ((self param: 'length') * aFrame rate + 0.5) floor.
	aFrame isSilent ifTrue: [
		on ifFalse: [^ nil].
		out := out + 1.
		out > (n + 10) ifTrue: [on := false. ^ nil].
		w := level * ((1 min: out / n) * Float pi / 2) cos.
		^ aFrame withData: (self mix: silence weight: w with: last)].
	on
		ifFalse: [on := true. g := 0. k := 0. onset := true]
		ifTrue: [out > 0 ifTrue: [
			w := level * ((1 min: out / n) * Float pi / 2) cos.
			g := (1 min: w) arcSin * 2 / Float pi.
			onset := false]].
	out := 0.
	last := aFrame data.
	base := (onset and: [k < onsets size]) ifTrue: [onsets at: k + 1] ifFalse: [silence].
	k := k + 1.
	w := ((1 min: g) * Float pi / 2) sin.
	g := g + (1.0 / n).
	level := w.
	^ w >= 1
		ifTrue: [aFrame]
		ifFalse: [aFrame withData: (self mix: base weight: w with: aFrame data)]
]
