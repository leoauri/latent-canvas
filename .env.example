# Used only by the Vite dev server's /__llm proxy; never sent to the browser.
OPENAI_API_KEY=

# Optional: any OpenAI-compatible endpoint, including the version path
# (default https://api.openai.com/v1; e.g. https://openrouter.ai/api/v1, http://localhost:11434/v1).
# The dev proxy forwards to it; without a key above, the page calls it directly.
OPENAI_BASE_URL=

# Optional: output token cap per reply, including reasoning (default 128000, gpt-5's maximum).
# Gateways often default to ~4k when it is not sent, which a coding agent quickly exceeds.
OPENAI_MAX_TOKENS=

# Optional: default model (default gpt-5); the chat settings can override it per browser.
OPENAI_MODEL=
